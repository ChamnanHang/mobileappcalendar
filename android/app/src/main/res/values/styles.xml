<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme shown while the process starts.

         Both this file and values-night/ use the dark parent: the app is
         dark-only (themeMode is pinned to dark in NotedApp), so following the
         system light theme here would only produce a white flash before the
         first Flutter frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>
</resources>
